{
  "mcpServers": {
    "dbhub": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}/.cursor/dbhub/node_modules/@bytebase/dbhub/dist/index.js"
      ],
      "env": {
        "NODE_ENV": "production",
        "DSN": "postgresql://docs:docs@10.7.0.1:5432/docs_registry",
        "TRANSPORT": "stdio"
      }
    }
  }
}
